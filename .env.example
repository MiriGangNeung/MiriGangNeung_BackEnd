# Copy this file to .env and replace only the values you actually have.
# Never commit .env or real credentials.

# Korean Tourism Organization Open API
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# Set true for one startup only when refreshing the full Gangneung place catalog.
TOUR_API_SYNC_ON_STARTUP=false
# Optional: use a separate key if PhotoGalleryService1 is not enabled for TOUR_API_KEY.
# TOUR_PHOTO_GALLERY_API_KEY=your-photo-gallery-service-key

# Kakao REST API
KAKAO_API_KEY=
KAKAO_API_BASE_URL=https://dapi.kakao.com
KAKAO_LOCAL_API_BASE_URL=https://dapi.kakao.com
KAKAO_LOCAL_API_TIMEOUT=5s
KAKAO_LOCAL_RADIUS_METERS=2000
KAKAO_LOCAL_PAGE_SIZE=15

# AI provider is intentionally not selected in P0.
AI_BASE_URL=
AI_API_KEY=

# Local Spring Boot defaults
DB_URL=jdbc:h2:mem:mirigangneung;MODE=MySQL;DB_CLOSE_DELAY=-1
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=8080

# Temporary image storage and CORS
IMAGE_TEMP_DIR=
IMAGE_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Docker-only optional overrides
MYSQL_PORT=3307
# APP_PORT=8080
# DB_ROOT_PASSWORD=root_password
